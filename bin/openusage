#!/usr/bin/python3 -I
"""Read OpenUsage.app's usage numbers without ever touching the keychain.

OpenUsage.app refreshes every provider every 5 min and keeps the result in its prefs
(com.robinebers.openusage, openusage.providerSnapshots.v9). This prints that snapshot and never runs the real CLI
(/usr/local/bin/openusage). Each real-CLI run reads every Claude account's keychain item on its own; an item it
may not read (claude-swap's per-account items, or any item a /login just rewrote) raises a macOS "allow access"
dialog. The old wrapper ran one CLI per provider and killed it after a few seconds, which left its dialog on
screen with nobody waiting on it, so every call and the hourly usage-log cron piled up more of them (2026-10-26).
Now only the app asks the keychain, at most once per account until "Always Allow" is clicked.

Output is the CLI's JSON shape plus, on each provider, "ageMinutes" and "source": "app-snapshot", "stale": true
when the snapshot is older than STALE_MINUTES (the app has not managed to refresh it), and at the top level
"claudeActive": the provider id of the account Claude Code is logged in to (~/.claude.json), which is the one that
paces Opus lanes. `--brief` prints one human line per provider instead of JSON.
Usage: openusage [provider] [--brief]
       openusage ... --force      hands over to the real CLI for a live fetch (may raise keychain dialogs)
       -h / -v                    go to the real CLI
"""
import datetime
import json
import os
import plistlib
import subprocess
import sys

REAL = "/usr/local/bin/openusage"
DOMAIN = "com.robinebers.openusage"
STALE_MINUTES = 15
NOW = datetime.datetime.now(datetime.timezone.utc)


def prefs():
    try:
        return plistlib.loads(subprocess.run(["/usr/bin/defaults", "export", DOMAIN, "-"],
                                             capture_output=True, timeout=5).stdout)
    except Exception:
        return {}


def parse_time(text):
    try:
        return datetime.datetime.fromisoformat(str(text).replace("Z", "+00:00"))
    except ValueError:
        return None


def age_minutes(text):
    when = parse_time(text)
    return None if when is None else round((NOW - when).total_seconds() / 60, 1)


def snapshot_provider(snapshot):
    """Turn an app snapshot (progress lines) into the CLI's provider shape."""
    resources = {}
    for line in snapshot.get("lines") or []:
        if line.get("type") != "progress" or line.get("used") is None:
            continue
        limit = line.get("limit") or 100
        resources[str(line.get("label") or "").lower()] = {
            "kind": "consumption", "unit": "percent", "used": line["used"], "limit": limit,
            "remaining": limit - line["used"], "resetsAt": line.get("resetsAt"),
            "windowSeconds": (line.get("periodDurationMs") or 0) // 1000 or None}
    fetched = snapshot.get("refreshedAt")
    age = age_minutes(fetched)
    return {"displayName": snapshot.get("displayName"), "plan": snapshot.get("plan"), "resources": resources,
            "fetchedAt": fetched, "stale": age is None or age > STALE_MINUTES, "source": "app-snapshot",
            "ageMinutes": age}


def active_claude(produced):
    try:
        with open(os.path.expanduser("~/.claude.json")) as source:
            account = (json.load(source).get("oauthAccount") or {}).get("accountUuid")
    except (OSError, ValueError):
        return None
    return next((pid for pid, key in produced.items() if account and str(key).startswith(account + "|")), None)


def main(argv):
    if any(a in ("-h", "--help", "-v", "--version", "--force") for a in argv):
        os.execv(REAL, [REAL] + [a for a in argv if a != "--brief"])
    brief = "--brief" in argv
    wanted = [a for a in argv if not a.startswith("-")]
    p = prefs()
    try:
        store = json.loads(p.get("openusage.providerSnapshots.v9") or "{}")
    except ValueError:
        store = {}
    snapshots, produced = store.get("snapshots") or {}, store.get("producedByIdentityKeys") or {}
    ids = list(p.get("openusage.enabledProviders.v1") or produced or snapshots)
    if wanted:
        ids = [i for i in ids if i == wanted[0] or i.startswith(wanted[0] + "@")]

    providers, errors = {}, []
    for pid in ids:
        if pid in snapshots:
            providers[pid] = snapshot_provider(snapshots[pid])
            if providers[pid]["stale"]:
                errors.append({"providerId": pid, "message": "OpenUsage.app has not refreshed it for %s min"
                               % providers[pid]["ageMinutes"]})
        else:
            errors.append({"providerId": pid, "message": "no snapshot in OpenUsage.app yet"})

    result = {"schema": None, "generatedAt": NOW.strftime("%Y-%m-%dT%H:%M:%S.000Z"),
              "claudeActive": active_claude(produced), "providers": providers, "errors": errors}
    if brief:
        for pid, prov in providers.items():
            res = prov.get("resources") or {}
            used = ", ".join("%s %s%%" % (k, (res[k] or {}).get("used")) for k in ("weekly", "session", "fable")
                             if (res.get(k) or {}).get("used") is not None)
            tag = " (active Claude)" if pid == result["claudeActive"] else ""
            stale = " STALE" if prov.get("stale") else ""
            print("%s%s: %s; %s min old%s" % (pid, tag, used or "no limits", prov.get("ageMinutes"), stale))
        for e in errors:
            print("warning: %s: %s" % (e.get("providerId"), e.get("message")), file=sys.stderr)
    else:
        print(json.dumps(result, separators=(",", ":")))
    return 0 if providers else 4


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
