#!/usr/bin/python3 -I
"""Thin wrapper around OpenUsage.app's CLI (/usr/local/bin/openusage) that never hangs.

The real CLI refreshes every provider in one process and waits up to 120 s for the slowest one. A Claude
account whose keychain item OpenUsage may not read (claude-swap writes items only /usr/bin/security can open)
raises a macOS "allow access" dialog, and the CLI then blocks the full 120 s and prints the other providers
late or not at all (2026-10-26). This wrapper asks for each provider id in parallel with a short timeout
(OPENUSAGE_TIMEOUT, default 8 s). A provider that times out or fails gets OpenUsage.app's last-good snapshot
instead, marked "stale": true with "source": "app-snapshot" and its age, so Codex numbers print when Claude
fails and nothing comes back empty.

Output is the CLI's JSON schema plus, on each provider, "ageMinutes" (and "source" for fallbacks), and at the
top level "claudeActive": the provider id of the account Claude Code is logged in to (~/.claude.json), which
is the one that paces Opus lanes. `--brief` prints one human line per provider instead of JSON.
Usage: openusage [provider] [--force] [--brief]     (-h / -v go to the real CLI)
"""
import datetime
import json
import os
import plistlib
import subprocess
import sys
import time

REAL = "/usr/local/bin/openusage"
DOMAIN = "com.robinebers.openusage"
TIMEOUT = float(os.environ.get("OPENUSAGE_TIMEOUT") or 8)
NOW = datetime.datetime.now(datetime.timezone.utc)


def prefs():
    try:
        return plistlib.loads(subprocess.run(["/usr/bin/defaults", "export", DOMAIN, "-"],
                                             capture_output=True, timeout=5).stdout)
    except Exception:
        return {}


def parse_time(text):
    try:
        return datetime.datetime.fromisoformat(str(text).replace("Z", "+00:00"))
    except ValueError:
        return None


def age_minutes(text):
    when = parse_time(text)
    return None if when is None else round((NOW - when).total_seconds() / 60, 1)


def snapshot_provider(snapshot):
    """Turn an app snapshot (progress lines) into the CLI's provider shape."""
    resources = {}
    for line in snapshot.get("lines") or []:
        if line.get("type") != "progress" or line.get("used") is None:
            continue
        limit = line.get("limit") or 100
        resources[str(line.get("label") or "").lower()] = {
            "kind": "consumption", "unit": "percent", "used": line["used"], "limit": limit,
            "remaining": limit - line["used"], "resetsAt": line.get("resetsAt"),
            "windowSeconds": (line.get("periodDurationMs") or 0) // 1000 or None}
    fetched = snapshot.get("refreshedAt")
    return {"displayName": snapshot.get("displayName"), "plan": snapshot.get("plan"), "resources": resources,
            "fetchedAt": fetched, "stale": True, "source": "app-snapshot", "ageMinutes": age_minutes(fetched)}


def active_claude(produced):
    try:
        with open(os.path.expanduser("~/.claude.json")) as source:
            account = (json.load(source).get("oauthAccount") or {}).get("accountUuid")
    except (OSError, ValueError):
        return None
    return next((pid for pid, key in produced.items() if account and str(key).startswith(account + "|")), None)


def main(argv):
    if any(a in ("-h", "--help", "-v", "--version") for a in argv):
        os.execv(REAL, [REAL] + argv)
    brief = "--brief" in argv
    flags = [a for a in argv if a == "--force"]
    wanted = [a for a in argv if not a.startswith("-")]
    p = prefs()
    try:
        store = json.loads(p.get("openusage.providerSnapshots.v9") or "{}")
    except ValueError:
        store = {}
    snapshots, produced = store.get("snapshots") or {}, store.get("producedByIdentityKeys") or {}
    ids = list(p.get("openusage.enabledProviders.v1") or produced or ["claude", "codex"])
    if wanted:
        ids = [i for i in ids if i == wanted[0] or i.startswith(wanted[0] + "@")] or wanted[:1]

    procs = {i: subprocess.Popen([REAL, i] + flags, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
             for i in ids}
    start = time.monotonic()
    providers, errors, schema = {}, [], None
    for pid, proc in procs.items():
        # The app refreshes every provider every 5 min; a snapshot older than 30 min means the app cannot
        # refresh this one either (same code, same keychain), so don't wait long for the CLI to try.
        stuck = (age_minutes((snapshots.get(pid) or {}).get("refreshedAt")) or 0) > 30
        budget = min(TIMEOUT, 2) if stuck else TIMEOUT
        try:
            out, err = proc.communicate(timeout=max(0.1, start + budget - time.monotonic()))
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.communicate()
            why = "app has not refreshed it for 30+ min" if stuck else "OPENUSAGE_TIMEOUT"
            errors.append({"providerId": pid, "message": "no answer in %gs (%s)" % (budget, why)})
            continue
        try:
            data = json.loads(out)
        except ValueError:
            errors.append({"providerId": pid, "message": (err or "invalid JSON").strip()[:200]})
            continue
        schema = schema or data.get("schema")
        got = (data.get("providers") or {}).get(pid)
        if got:
            got["ageMinutes"] = age_minutes(got.get("fetchedAt"))
            providers[pid] = got
        errors += [e for e in data.get("errors") or [] if e.get("providerId") == pid]

    for pid in ids:
        failed = any(e.get("providerId") == pid for e in errors)
        if (pid not in providers or failed) and pid in snapshots:
            # Prefer the app's snapshot when it is newer than what the CLI returned.
            fallback = snapshot_provider(snapshots[pid])
            mine = providers.get(pid)
            if mine is None or (age_minutes(mine.get("fetchedAt")) or 1e9) > (fallback["ageMinutes"] or 1e9):
                providers[pid] = fallback

    result = {"schema": schema, "generatedAt": NOW.strftime("%Y-%m-%dT%H:%M:%S.000Z"),
              "claudeActive": active_claude(produced), "providers": providers, "errors": errors}
    if brief:
        for pid, prov in providers.items():
            res = prov.get("resources") or {}
            used = ", ".join("%s %s%%" % (k, (res[k] or {}).get("used")) for k in ("weekly", "session", "fable")
                             if (res.get(k) or {}).get("used") is not None)
            tag = " (active Claude)" if pid == result["claudeActive"] else ""
            stale = " STALE" if prov.get("stale") else ""
            print("%s%s: %s; %s min old%s" % (pid, tag, used or "no limits", prov.get("ageMinutes"), stale))
        for e in errors:
            print("warning: %s: %s" % (e.get("providerId"), e.get("message")), file=sys.stderr)
    else:
        print(json.dumps(result, separators=(",", ":")))
    return 0 if providers else 4


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
