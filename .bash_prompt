# @gf3’s Sexy Bash Prompt, inspired by “Extravagant Zsh Prompt”
# Shamelessly copied from https://github.com/gf3/dotfiles
# Screenshot: http://i.imgur.com/s0Blh.png

if [[ $COLORTERM = gnome-* && $TERM = xterm ]] && infocmp gnome-256color >/dev/null 2>&1; then
	export TERM=gnome-256color
elif infocmp xterm-256color >/dev/null 2>&1; then
	export TERM=xterm-256color
fi

if tput setaf 1 &> /dev/null; then
	tput sgr0
	if [[ $(tput colors) -ge 256 ]] 2>/dev/null; then
		MAGENTA=$(tput setaf 9)
		ORANGE=$(tput setaf 172)
		GREEN=$(tput setaf 190)
		PURPLE=$(tput setaf 141)
		WHITE=$(tput setaf 0)
	else
		MAGENTA=$(tput setaf 5)
		ORANGE=$(tput setaf 4)
		GREEN=$(tput setaf 2)
		PURPLE=$(tput setaf 1)
		WHITE=$(tput setaf 7)
	fi
	BOLD=$(tput bold)
	RESET=$(tput sgr0)
else
	MAGENTA="\033[1;31m"
	ORANGE="\033[1;33m"
	GREEN="\033[1;32m"
	PURPLE="\033[1;35m"
	WHITE="\033[1;37m"
	BOLD=""
	RESET="\033[m"
fi

# in production we must set the proper colors
if [ "$IS_LOCAL_MACHINE" != "1" ]; then
	MAGENTA="\033[1;33m"
	ORANGE="\033[1;33m"
	GREEN="\033[1;33m"
	PURPLE="\033[1;33m"
	WHITE="\033[1;33m"
	BOLD=""
	RESET="\033[m"
fi

export MAGENTA
export ORANGE
export GREEN
export PURPLE
export WHITE
export BOLD
export RESET

# Git info for the prompt.
#
# This used to render as three separate `git` processes per prompt: `git branch`
# to decide whether to print " on ", then parse_git_branch's own `git branch`
# piped through sed, then parse_git_dirty's full `git status` piped through
# tail. In a repo of any size that is the slowest thing that happens between
# pressing Return and getting a prompt back.
#
# Worse for a multi-pane setup: a plain `git status` takes .git/index.lock to
# refresh the index, so N shells sitting in the same repo serialise against each
# other every time any of them draws a prompt. --no-optional-locks tells git to
# skip that write entirely, and --porcelain=v2 --branch gets branch name and
# dirty state out of a single invocation.
#
# Result is left in two variables rather than command-substituted from PS1, so
# it is computed once per prompt instead of once per PS1 evaluation.
__prompt_git() {
	__GIT_ON=""
	__GIT_BRANCH=""

	local out
	out=$(git --no-optional-locks status --porcelain=v2 --branch 2>/dev/null) || return

	local branch=${out#*'# branch.head '}
	if [ "$branch" != "$out" ]; then
		branch=${branch%%$'\n'*}
	else
		branch=""
	fi

	# Every header line starts with '# '; anything else is a changed, staged,
	# unmerged or untracked path — i.e. the working tree is dirty.
	local dirty=""
	case $'\n'"$out" in
		*$'\n'[!\#]*) dirty="*" ;;
	esac

	__GIT_ON=" on "
	__GIT_BRANCH="${branch}${dirty}"
}

# Kept as thin wrappers: they were the documented way to get this info, and
# other scripts/aliases may still call them.
function parse_git_dirty() {
	__prompt_git
	case "$__GIT_BRANCH" in *"*") echo "*" ;; esac
}

function parse_git_branch() {
	__prompt_git
	[ -n "$__GIT_BRANCH" ] && echo "$__GIT_BRANCH"
}

# Prepend rather than assign: set_terminal_title() in ~/.functions also writes
# PROMPT_COMMAND, and whichever ran last used to win.
case "${PROMPT_COMMAND:-}" in
	*__prompt_git*) ;;
	"") PROMPT_COMMAND="__prompt_git" ;;
	*) PROMPT_COMMAND="__prompt_git; $PROMPT_COMMAND" ;;
esac

export PS1="\[${BOLD}${MAGENTA}\]\u \[$MAGENTA\]at \[$ORANGE\]\h  \n\[$GREEN\]\w\${__GIT_ON}\[$PURPLE\]\${__GIT_BRANCH}\n\$ \[$RESET\]"
export PS2="\[$ORANGE\]→ \[$RESET\]"
