PROJECT_ROOT="$HOME/projects"

## NPM / repo scaffolds

function npmify() {
    local result=ngenplus $1 $2

    if [ $result == 22 ]
    then
        echo "ngenplus failed!"
        return
    fi
    nstart
}

# Deals with not disk
function __nstart() {
    local testling=0
    local travis=0
    local repoName=$1

    # dumb args parsing since I couldn't get getopts to work inside a function
    # -a turns on travis, -s turns on testling
    for v in $@
    do
      [[ $v == '-a' ]] && travis=1
      [[ $v == '-s' ]] && testling=1
    done

    # deals with git
    git init
    git add .
    git commit -m "initial"
    # deals with github
    hub create $repoName
    git push origin master

    # deals with travis
    if [[ $travis == 1 ]]; then
        travisify
        travisify test
    fi

    # deals with testling
    if [[ $testling == 1 ]]; then
        testlingify
        testlingify test
    fi

    npm publish
}

function nstart() {
    __nstart "$(basename $PWD)" "$@"
}

function colingo-nstart() {
    __nstart "Colingo/$(basename $PWD)" "$@"
}

function __ngenplus() {
    local scaffold=$1
    local projectName=$2
    local isFree=""

    isFree="$(npm info $projectName 2>&1 | grep 'npm ERR! 404 You should bug the author to publish it')"

    # if $isFree is empty then BAD. If it's not empty then GOOD
    if [[ ! -n "$isFree" ]]; then
        echo "$projectName already taken on npm"
        npm info ${projectName} name description author
        return 22
    fi

    local tmpf=$(tempfile)

    if [ ! -z $3 ]; then
        cp "$3" $tmpf
    fi

    cd $PROJECT_ROOT
    $scaffold $projectName
    cd $projectName

    if [ ! -z $3 ]; then
        cp "$tmpf" ./index.js
        rm $tmpf
    fi

    npm i
}

function ngenplus() {
    __ngenplus "ngen" $1 $2
}

function colingo-ngenplus() {
    __ngenplus "colingo-ngen" $1 $2
}

## Git and github work flows

# ENSURE that you have hub installed locally.
# Opens a pull request from your origin remote to another
# remote on a branch on github.
# Will open up a git style editor for the pull request message
# body.
# the branch defaults to the checked out branch. To change it
# pass in $1.
# the remote defaults to the named remote github. To change it
# pass in $2. ENSURE that the remote is a github username and not
# a git remote.
# pr_github ${BRANCH} ${REMOTE}
function pr_github() {
    local branch="${1:-$(git rev-parse --abbrev-ref HEAD)}"

    local status="$(git status | grep 'Changes to be committed')"

    if [[ -n "$status" ]]; then
        echo git commit
        git commit 3>&1 1>&2 2>&3
    fi

    local origin="$(git remote -v | grep 'origin\s' | head -n 1 | awk '{ match($0, /git@github.com\:([-_a-zA-Z]+)/); split(substr($0, RSTART, RLENGTH), a, /[":]/); print a[2] }')"
    local github="$(git remote -v | grep 'github\s' | head -n 1 | awk '{ match($0, /git@github.com\:([-_a-zA-Z]+)/); split(substr($0, RSTART, RLENGTH), a, /[":]/); print a[2] }')"

    local remote=${2:-$github}

    git fetch github
    result="$(git pull github $branch | grep 'Merge conflict in')"

    if [ "$result" != "" ]; then
        echo "MERGE CONFLICT ;___;"
        return 1
    fi

    git push origin $branch
    echo git push $origin $branch
    exec 5>&1
    echo hub pull-request -h $origin:$branch -b $remote:$branch
    local uri="$( (hub pull-request -h $origin:$branch -b $remote:$branch) | tee /dev/fd/5)"
    # echo "uri $uri"

    # if [ "$uri" != "Aborting due to empty pull request title" && "$uri" != "" ]
    # then
        # echo "open $uri"
        # google-chrome "$uri"
    # fi
    # TODO: auto merge
}

function tap-fail() {
    local file="$(mktemp)"
    local testfile=${1:-test/index.js}

    node $testfile 1> file;

    local fails=$(cat file | grep 'at:' | awk '{ split($3, a, ":"); print a[1]; }' | uniq | cut -c2-999)

    echo "Failing files: "
    echo ""
    echo "$fails"
    echo ""
    echo "$(cat file | tail -n5)"

    rm $file;
}

## Utils

function set_terminal_title() {
    export ___TERMINAL_TITLE=$1
    PROMPT_COMMAND='echo -ne "\033]0;${___TERMINAL_TITLE}\007"'
}

function watcher()
{ 
  WATCHERTIME=$1
  WATCHERFILE=/tmp/watcher$$
  shift
  while true; do
    WATCHERHEIGHT=$(($LINES - 5))
    ( eval $* ) | head -n ${WATCHERHEIGHT} > ${WATCHERFILE} 2>/dev/null
    clear
    /bin/echo -n "Every ${WATCHERTIME} seconds - "
    date
    /bin/echo
    cat ${WATCHERFILE}
    \rm -f ${WATCHERFILE}
    /bin/echo
    /bin/echo "=="
    sleep ${WATCHERTIME}
  done
}

function pygless() {
    LESSOPEN="| pygmentize -f terminal256 -O style=native -g %s" less -R "$@";
}

function disable_workspace_keys() {
    gsettings set org.gnome.desktop.wm.keybindings switch-to-workspace-left "['<Control><Alt><Shift><Super>Left']"
    gsettings set org.gnome.desktop.wm.keybindings switch-to-workspace-right "['<Control><Alt><Shift><Super>Right']"
    gsettings set org.gnome.desktop.wm.keybindings switch-to-workspace-up "['<Control><Alt><Shift><Super>Up']"
    gsettings set org.gnome.desktop.wm.keybindings switch-to-workspace-down "['<Control><Alt><Shift><Super>Down']"
}

function enable_workspace_keys() {
    gsettings set org.gnome.desktop.wm.keybindings switch-to-workspace-left "['<Control><Alt>Left']"
    gsettings set org.gnome.desktop.wm.keybindings switch-to-workspace-right "['<Control><Alt>Right']"
    gsettings set org.gnome.desktop.wm.keybindings switch-to-workspace-up "['<Control><Alt>Up']"
    gsettings set org.gnome.desktop.wm.keybindings switch-to-workspace-down "['<Control><Alt>Down']"
}

function disable_other_spaces() {
    gsettings set org.gnome.desktop.wm.keybindings switch-to-workspace-left "['<Control><Alt><Shift><Super>Left']"
    gsettings set org.gnome.desktop.wm.keybindings switch-to-workspace-right "['<Control><Alt><Shift><Super>Right']"
}

function top_grep() {
    local expr = "$1";
    top -d1 -p $(pgrep $expr | head -n20 | xargs | sed 's/ /,/g')
}

function maybe-jq() {
    local jqarg=$1

    while IFS= read -r line
    do
        if [[ ${line:0:1} == "{" ]] ;
        then
            echo "$line" | jq "$jqarg"
        else
            echo "$line"
        fi
    done < "/dev/stdin"
}

## herdr: every live agent, across every herdr session

# `herdr agent list` only ever answers for ONE session — the one its socket
# points at — so from inside a pane you can only see your own session's agents.
# This walks `herdr session list --json` and re-asks each running session over
# its own socket_path.
#
# Targeting is by HERDR_SOCKET_PATH, deliberately NOT `herdr --session <name>`:
# the latter auto-creates a whole session on an unknown name (same trap
# bin/herdr-attach exists to close), while a socket path can only ever hit a
# server that already exists.
#
# Live panes only — nothing here reads ~/.claude. A session with no agents
# prints one "-" row, so an empty session is visible rather than missing.
function herdr-agents() {
    local kind=claude agents_only=0 working=0 json=0 usage sessions name sock

    usage='usage: herdr-agents [-k KIND] [-A] [-w] [-j]

  -k, --kind KIND    agent kind to list (default: claude, "any" for every kind)
  -A, --agents-only  hide herdr sessions that have no matching agent
  -w, --working      only agents whose status is "working"
  -j, --json         one JSON object per agent instead of a table
  -h, --help         show this'

    while (( $# )); do
        case "$1" in
            -k|--kind)        kind=${2?--kind needs a value}; shift 2 ;;
            -A|--agents-only) agents_only=1; shift ;;
            -w|--working)     working=1; shift ;;
            -j|--json)        json=1; shift ;;
            -h|--help)        printf '%s\n' "$usage"; return 0 ;;
            *)                printf '%s\n' "$usage" >&2; return 1 ;;
        esac
    done

    command -v herdr >/dev/null 2>&1 ||
        { printf 'herdr-agents: herdr is not in PATH\n' >&2; return 1; }

    sessions=$(command herdr session list --json 2>/dev/null) ||
        { printf 'herdr-agents: no herdr server answered\n' >&2; return 1; }

    __herdr_agents_rows() {
        local name sock
        while IFS=$'\t' read -r name sock; do
            HERDR_SOCKET_PATH=$sock command herdr agent list 2>/dev/null |
                jq -rc --arg sess "$name" --arg kind "$kind" \
                      --argjson working "$working" --argjson json "$json" '
                    [ (.result.agents // [])[]
                      | select($kind == "any" or .agent == $kind)
                      | select($working == 0 or .agent_status == "working") ]
                    | if $json == 1 then
                          .[] | {session: $sess, kind: .agent, status: .agent_status,
                                 pane: .pane_id, cwd: (.foreground_cwd // .cwd),
                                 goal: .tokens.goal, title: .terminal_title_stripped,
                                 claude_session: .agent_session.value}
                      elif length == 0 then
                          [$sess, "-", "-", "-", "-", "-"] | @tsv
                      else
                          .[] | [ $sess, .pane_id, .agent_status,
                                  (.foreground_cwd // .cwd // "-"),
                                  (.tokens.goal // "-"),
                                  (.terminal_title_stripped // .terminal_title // "-")
                                ] | @tsv
                      end'
        done < <(jq -r '.sessions[] | select(.running) | [.name, .socket_path] | @tsv' <<<"$sessions")
    }

    if (( json )); then
        __herdr_agents_rows
        unset -f __herdr_agents_rows
        return 0
    fi

    __herdr_agents_rows | awk -F'\t' -v home="$HOME" -v cols="${COLUMNS:-100}" \
                                     -v agents_only="$agents_only" -v kind="$kind" '
        function clip(s, n) {
            return (n > 1 && length(s) > n) ? substr(s, 1, n - 1) "\342\200\246" : s
        }
        function widen(n, s) { return length(s) > n ? length(s) : n }
        {
            if (!($1 in allsess)) { allsess[$1] = 1; nsess++ }
            if (agents_only && $2 == "-") next
            r++
            sess[r] = $1; pane[r] = $2; st[r] = $3
            c = $4; sub("^" home, "~", c); cwd[r] = c
            goal[r] = clip($5, 28); title[r] = $6
            w1 = widen(w1, $1); w2 = widen(w2, $2)
            w3 = widen(w3, $3); w4 = widen(w4, c); w5 = widen(w5, goal[r])
            if ($2 != "-") {
                live++
                busy += ($3 == "working")
                if (!($1 in seen)) { seen[$1] = 1; withagents++ }
            }
        }
        END {
            if (!r) { print "no running herdr sessions"; exit }
            w1 = widen(w1, "SESSION"); w2 = widen(w2, "PANE"); w3 = widen(w3, "STATUS")
            w4 = widen(w4, "CWD");     w5 = widen(w5, "GOAL")
            tw = cols - (w1 + w2 + w3 + w4 + w5 + 10)

            fmt = "%-" w1 "s  %-" w2 "s  %-" w3 "s  %-" w4 "s  %-" w5 "s  %s\n"
            printf fmt, "SESSION", "PANE", "STATUS", "CWD", "GOAL", "TITLE"
            for (i = 1; i <= r; i++)
                printf fmt, sess[i], pane[i], st[i], cwd[i], goal[i], clip(title[i], tw)

            printf "\n%d live %sagent%s in %d of %d herdr sessions, %d working\n",
                live + 0, (kind == "any" ? "" : kind " "), (live == 1 ? "" : "s"),
                withagents + 0, nsess + 0, busy + 0
        }
    '

    unset -f __herdr_agents_rows
}



