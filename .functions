PROJECT_ROOT="$HOME/projects"

## NPM / repo scaffolds

function npmify() {
    local result=ngenplus $1 $2

    if [ $result == 22 ]
    then
        echo "ngenplus failed!"
        return
    fi
    nstart
}

# Deals with not disk
function __nstart() {
    local testling=0
    local travis=0
    local repoName=$1

    # dumb args parsing since I couldn't get getopts to work inside a function
    # -a turns on travis, -s turns on testling
    for v in $@
    do
      [[ $v == '-a' ]] && travis=1
      [[ $v == '-s' ]] && testling=1
    done

    # deals with git
    git init
    git add .
    git commit -m "initial"
    # deals with github
    hub create $repoName
    git push origin master

    # deals with travis
    if [[ $travis == 1 ]]; then
        travisify
        travisify test
    fi

    # deals with testling
    if [[ $testling == 1 ]]; then
        testlingify
        testlingify test
    fi

    npm publish
}

function nstart() {
    __nstart "$(basename $PWD)" "$@"
}

function __ngenplus() {
    local scaffold=$1
    local projectName=$2
    local isFree=""

    isFree="$(npm info $projectName 2>&1 | grep 'npm ERR! 404 You should bug the author to publish it')"

    # if $isFree is empty then BAD. If it's not empty then GOOD
    if [[ ! -n "$isFree" ]]; then
        echo "$projectName already taken on npm"
        npm info ${projectName} name description author
        return 22
    fi

    local tmpf=$(tempfile)

    if [ ! -z $3 ]; then
        cp "$3" $tmpf
    fi

    cd $PROJECT_ROOT
    $scaffold $projectName
    cd $projectName

    if [ ! -z $3 ]; then
        cp "$tmpf" ./index.js
        rm $tmpf
    fi

    npm i
}

function ngenplus() {
    __ngenplus "ngen" $1 $2
}

## Git and github work flows

# ENSURE that you have hub installed locally.
# Opens a pull request from your origin remote to another
# remote on a branch on github.
# Will open up a git style editor for the pull request message
# body.
# the branch defaults to the checked out branch. To change it
# pass in $1.
# the remote defaults to the named remote github. To change it
# pass in $2. ENSURE that the remote is a github username and not
# a git remote.
# pr_github ${BRANCH} ${REMOTE}
function pr_github() {
    local branch="${1:-$(git rev-parse --abbrev-ref HEAD)}"

    local status="$(git status | grep 'Changes to be committed')"

    if [[ -n "$status" ]]; then
        echo git commit
        git commit 3>&1 1>&2 2>&3
    fi

    local origin="$(git remote -v | grep 'origin\s' | head -n 1 | awk '{ match($0, /git@github.com\:([-_a-zA-Z]+)/); split(substr($0, RSTART, RLENGTH), a, /[":]/); print a[2] }')"
    local github="$(git remote -v | grep 'github\s' | head -n 1 | awk '{ match($0, /git@github.com\:([-_a-zA-Z]+)/); split(substr($0, RSTART, RLENGTH), a, /[":]/); print a[2] }')"

    local remote=${2:-$github}

    git fetch github
    result="$(git pull github $branch | grep 'Merge conflict in')"

    if [ "$result" != "" ]; then
        echo "MERGE CONFLICT ;___;"
        return 1
    fi

    git push origin $branch
    echo git push $origin $branch
    exec 5>&1
    echo hub pull-request -h $origin:$branch -b $remote:$branch
    local uri="$( (hub pull-request -h $origin:$branch -b $remote:$branch) | tee /dev/fd/5)"
    # echo "uri $uri"

    # if [ "$uri" != "Aborting due to empty pull request title" && "$uri" != "" ]
    # then
        # echo "open $uri"
        # google-chrome "$uri"
    # fi
    # TODO: auto merge
}

function tap-fail() {
    local file="$(mktemp)"
    local testfile=${1:-test/index.js}

    node $testfile 1> file;

    local fails=$(cat file | grep 'at:' | awk '{ split($3, a, ":"); print a[1]; }' | uniq | cut -c2-999)

    echo "Failing files: "
    echo ""
    echo "$fails"
    echo ""
    echo "$(cat file | tail -n5)"

    rm $file;
}

## Utils

function set_terminal_title() {
    export ___TERMINAL_TITLE=$1
    # Append instead of assigning: this used to overwrite PROMPT_COMMAND
    # wholesale, silently dropping the git-info hook set up in ~/.bash_prompt.
    local emit='echo -ne "\033]0;${___TERMINAL_TITLE}\007"'
    case "${PROMPT_COMMAND:-}" in
        *___TERMINAL_TITLE*) ;;
        "") PROMPT_COMMAND="$emit" ;;
        *) PROMPT_COMMAND="$PROMPT_COMMAND; $emit" ;;
    esac
}

function watcher()
{ 
  WATCHERTIME=$1
  WATCHERFILE=/tmp/watcher$$
  shift
  while true; do
    WATCHERHEIGHT=$(($LINES - 5))
    ( eval $* ) | head -n ${WATCHERHEIGHT} > ${WATCHERFILE} 2>/dev/null
    clear
    /bin/echo -n "Every ${WATCHERTIME} seconds - "
    date
    /bin/echo
    cat ${WATCHERFILE}
    \rm -f ${WATCHERFILE}
    /bin/echo
    /bin/echo "=="
    sleep ${WATCHERTIME}
  done
}

function pygless() {
    LESSOPEN="| pygmentize -f terminal256 -O style=native -g %s" less -R "$@";
}

function disable_workspace_keys() {
    gsettings set org.gnome.desktop.wm.keybindings switch-to-workspace-left "['<Control><Alt><Shift><Super>Left']"
    gsettings set org.gnome.desktop.wm.keybindings switch-to-workspace-right "['<Control><Alt><Shift><Super>Right']"
    gsettings set org.gnome.desktop.wm.keybindings switch-to-workspace-up "['<Control><Alt><Shift><Super>Up']"
    gsettings set org.gnome.desktop.wm.keybindings switch-to-workspace-down "['<Control><Alt><Shift><Super>Down']"
}

function enable_workspace_keys() {
    gsettings set org.gnome.desktop.wm.keybindings switch-to-workspace-left "['<Control><Alt>Left']"
    gsettings set org.gnome.desktop.wm.keybindings switch-to-workspace-right "['<Control><Alt>Right']"
    gsettings set org.gnome.desktop.wm.keybindings switch-to-workspace-up "['<Control><Alt>Up']"
    gsettings set org.gnome.desktop.wm.keybindings switch-to-workspace-down "['<Control><Alt>Down']"
}

function disable_other_spaces() {
    gsettings set org.gnome.desktop.wm.keybindings switch-to-workspace-left "['<Control><Alt><Shift><Super>Left']"
    gsettings set org.gnome.desktop.wm.keybindings switch-to-workspace-right "['<Control><Alt><Shift><Super>Right']"
}

function top_grep() {
    local expr = "$1";
    top -d1 -p $(pgrep $expr | head -n20 | xargs | sed 's/ /,/g')
}

function maybe-jq() {
    local jqarg=$1

    while IFS= read -r line
    do
        if [[ ${line:0:1} == "{" ]] ;
        then
            echo "$line" | jq "$jqarg"
        else
            echo "$line"
        fi
    done < "/dev/stdin"
}





# ===== Remote Control by default =====
# Remote Control is opt-in per session: you either run /remote-control inside a
# session or start it with `claude --remote-control`. There is NO settings key
# for it -- the only `remoteControl` object settings.json accepts is
# `{ "shareHostProfile": ... }` (verified against the 2.1.275 validator), and
# no CLAUDE_CODE_* env var enables it either. So a wrapper is the only way to
# make it the default, and it has to be a *function*: the Herdr app's agent
# launcher runs shell functions (not aliases) from the login shell, so agents
# started from its menus pick this up exactly like a hand-typed one.
#
# Deliberately NOT added when: the flag is already present; a subcommand is in
# play (`claude mcp`, `claude update`, ...); it is a one-shot/non-interactive run
# (-p/--print, piped stdin); or we are already inside a Remote Control session.
# `command claude` remains the explicit bypass.
alias claude >/dev/null 2>&1 && unalias claude
claude() {
    local arg skip=0

    # Already inside a Remote Control session -- do not nest.
    [ -n "${CLAUDE_CODE_REMOTE_SESSION_ID:-}" ] && skip=1

    # Non-interactive stdin means a script or a pipe, not a session to drive.
    [ -t 0 ] || skip=1

    for arg in "$@"; do
        case "$arg" in
            --remote-control|--remote-control=*) skip=1 ;;
            -p|--print) skip=1 ;;
            # Subcommands and informational flags never open a session.
            agents|attach|auth|auto-mode|doctor|gateway|import|install|logs|mcp|\
            plugin|plugins|project|respawn|rm|setup-token|stop|kill|ultrareview|\
            update|upgrade|-h|--help|-v|--version) skip=1 ;;
        esac
        [ "$skip" = 1 ] && break
    done

    if [ "$skip" = 1 ]; then
        command claude "$@"
    else
        command claude --remote-control "$@"
    fi
}
# ===== end Remote Control by default =====
