# Generated by repo-kit scripts/agent-policy.mjs from one safety spec (MULTI-AGENT-TOOLING MA9).
# Edit the spec, not this file; Claude Code gets the same rules as permissions.deny.
prefix_rule(pattern=["sudo"], decision="forbidden", justification="no root from an agent session")
prefix_rule(pattern=["chmod", "-R"], decision="forbidden", justification="no recursive permission changes")
prefix_rule(pattern=["chmod", "777"], decision="forbidden", justification="no world-writable files")
prefix_rule(pattern=["chown", "-R"], decision="forbidden", justification="no recursive ownership changes")
prefix_rule(pattern=["dd"], decision="forbidden", justification="raw disk writes")
prefix_rule(pattern=["mkfs"], decision="forbidden", justification="formats a disk")
prefix_rule(pattern=["git", "push", "--force"], decision="forbidden", justification="never rewrite shared history")
prefix_rule(pattern=["git", "push", "-f"], decision="forbidden", justification="never rewrite shared history")
prefix_rule(pattern=["git", "reset", "--hard"], decision="forbidden", justification="discards work, often another agent's")
prefix_rule(pattern=["git", "clean", "-f"], decision="forbidden", justification="deletes untracked work, often another agent's")
