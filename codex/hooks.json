{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.local/bin/dcg\"",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "python3 \"$HOME/.claude/hooks/guard-chrome-keychain.py\"",
            "type": "command",
            "timeout": 5
          },
          {
            "command": "python3 \"$HOME/.claude/hooks/guard-rm.py\"",
            "type": "command",
            "timeout": 5
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.codex/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
