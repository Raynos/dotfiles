{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "/Users/raynos/.local/bin/dcg",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
