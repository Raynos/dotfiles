# Homebrew (macOS, Apple Silicon) — bash logins don't get .zprofile's shellenv
[ -d /opt/homebrew/bin ] && export PATH="/opt/homebrew/bin:$PATH"
# psql and friends without linking the full postgres formula
[ -d /opt/homebrew/opt/libpq/bin ] && export PATH="$PATH:/opt/homebrew/opt/libpq/bin"

# Add the opencode CLI (installed by the opencode installer)
export PATH="$HOME/.opencode/bin:$PATH"

# Add `~/bin` to the `$PATH`
export PATH="$HOME/bin:$PATH"
# Add node_modules to path
export PATH="node_modules/.bin:$PATH"
# Add `~/.local/bin` to the `$PATH`
export PATH="$HOME/.local/bin:$PATH"

export PATH=$PATH:/usr/local/go/bin
export PATH=$PATH:/opt/gradle/gradle-4.4.1/bin

mkdir -p "$HOME/gocode"
export GOPATH="$HOME/gocode"
export PATH="$PATH:$GOPATH/bin"

export PATH="$HOME/.cargo/bin:$PATH"

# Docker Desktop CLI plugins (docker-credential-osxkeychain etc.) — Docker
# appends this to ~/.bash_profile/~/.profile on first run, but bootstrap.sh's
# rsync clobbers those; keep it here instead.
[ -d "$HOME/.docker/bin" ] && export PATH="$PATH:$HOME/.docker/bin"

# Raise opencode's per-response output cap (default 32k) — DeepSeek V4 Flash supports 384k
export OPENCODE_EXPERIMENTAL_OUTPUT_TOKEN_MAX=131072
