# Add the opencode CLI (installed by the opencode installer)
export PATH="$HOME/.opencode/bin:$PATH"

# Add `~/bin` to the `$PATH`
export PATH="$HOME/bin:$PATH"
# Add node_modules to path
export PATH="node_modules/.bin:$PATH"
# Add `~/.local/bin` to the `$PATH`
export PATH="$HOME/.local/bin:$PATH"

export PATH=$PATH:/usr/local/go/bin
export PATH=$PATH:/opt/gradle/gradle-4.4.1/bin

mkdir -p "$HOME/gocode"
export GOPATH="$HOME/gocode"
export PATH="$PATH:$GOPATH/bin"

export PATH="$HOME/.cargo/bin:$PATH"

# Raise opencode's per-response output cap (default 32k) — DeepSeek V4 Flash supports 384k
export OPENCODE_EXPERIMENTAL_OUTPUT_TOKEN_MAX=131072
