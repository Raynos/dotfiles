{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash",
      "Edit",
      "Write",
      "MultiEdit",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Agent",
      "mcp__context7__*",
      "mcp__linear-server__*",
      "Skill",
      "SendUserFile",
      "Artifact",
      "ArtifactComments",
      "ArtifactData",
      "DesignSync",
      "Workflow",
      "AskUserQuestion",
      "EnterPlanMode",
      "ExitPlanMode",
      "mcp__claude_ai_Claude_Docs__*",
      "mcp__claude_ai_Google_Drive__*",
      "mcp__claude_ai_Gmail__*",
      "mcp__claude_ai_Google_Calendar__*",
      "mcp__plugin_sentry_sentry__*"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(chmod -R:*)",
      "Bash(chmod 777:*)",
      "Bash(chown -R:*)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/dcg\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/guard-rm.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/guard-chrome-keychain.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/commit-trailer-rule.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-session-label.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-session-label.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/session-label-remind.sh\""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/auto-deny.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline"
  },
  "extraKnownMarketplaces": {},
  "skipDangerousModePermissionPrompt": true,
  "model": "opus",
  "cleanupPeriodDays": 36500,
  "effortLevel": "high",
  "askUserQuestionTimeout": "10m",
  "attribution": {
    "commit": ""
  },
  "tui": "fullscreen",
  "theme": "dark",
  "preferredNotifChannel": "notifications_disabled",
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "400000",
    "CLAUDE_STATUSLINE_CHAIN": "$HOME/.claude/statusline-chain.sh",
    "CLAUDE_CODE_PLUGIN_DIRS": "$DOTFILES/claude/mods/inline-images",
    "GOMAXPROCS": "4"
  }
}
